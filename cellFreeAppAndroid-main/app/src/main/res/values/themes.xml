<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.CellFreeApp" parent="Theme.MaterialComponents.Light.DarkActionBar">
        <!-- Primary CellFree brand colors -->
        <item name="colorPrimary">@color/cellfree_primary</item>
        <item name="colorPrimaryVariant">@color/cellfree_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/cellfree_accent</item>
        <item name="colorSecondaryVariant">@color/cellfree_dark</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- Status bar color -->
        <item name="android:statusBarColor">@color/cellfree_primary</item>
        <!-- Background colors -->
        <item name="android:windowBackground">@color/white</item>
    </style>
    
    <!-- Theme for activities without action bar -->
    <style name="Theme.CellFreeApp.NoActionBar" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/cellfree_primary</item>
        <item name="colorPrimaryVariant">@color/cellfree_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/cellfree_accent</item>
        <item name="colorSecondaryVariant">@color/cellfree_dark</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:statusBarColor">@color/cellfree_primary</item>
        <item name="android:windowBackground">@color/white</item>
    </style>
    
    <!-- Bottom Sheet Dialog Theme -->
    <style name="BottomSheetDialogTheme" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/BottomSheetStyle</item>
    </style>
    
    <style name="BottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
    </style>
    
    <!-- Calendar Styles -->
    <style name="CalendarHeaderText">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/cellfree_primary</item>
    </style>
    
    <style name="CalendarDateText">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/black</item>
    </style>
    
    <style name="CalendarWeekText">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/cellfree_primary</item>
    </style>

    <style name="CalendarWeekLabel">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/cellfree_primary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

</resources>